+                ImmutableList.copyOf(new SortOrder[] {SortOrder.ASC_NULLS_LAST}),
+                false);
+
+        DriverContext driverContext = createDriverContext(1000);
+        Operator operator = operatorFactory.createOperator(driverContext);
