+        expected.expect(DecompressionException.class);
+
+        final EmbeddedChannel decoder = new EmbeddedChannel(new Lz4FrameDecoder(false));
+        final ByteBuf input = decoder.alloc().buffer();
+        input.writeLong(MAGIC_NUMBER);
