+/************************************************************************/
+/*                       WrapPointDateLine()                            */
+/************************************************************************/
+
+static void WrapPointDateLine(OGRPoint *poPoint)
+{
+    if (poPoint->getX() > 180)
+    {
+        poPoint->setX(fmod(poPoint->getX() + 180, 360) - 180);
+    }
+    else if (poPoint->getX() < -180)
+    {
+        poPoint->setX(-(fmod(-poPoint->getX() + 180, 360) - 180));
+    }
+}
