+def test_ogr_openfilegdb_ilike():
+
+    ds = ogr.Open("data/filegdb/Domains.gdb/a00000001.gdbtable")
+    lyr = ds.GetLayer(0)
+
+    lyr.SetAttributeFilter("Name = 'Roads'")
+    assert lyr.GetFeatureCount() == 1
+
+    lyr.SetAttributeFilter("Name ILIKE 'Roads'")
