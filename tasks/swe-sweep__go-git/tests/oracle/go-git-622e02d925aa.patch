+func isPathInDirectory(path, directory string) bool {
+	ps := strings.Split(path, "/")
+	ds := strings.Split(directory, "/")
+
+	if len(ds) == 1 && ds[0] == "." {
+		return true
+	}
+
+	if len(ps) < len(ds) {
+		return false
+	}
+
+	for i := 0; i < len(ds); i++ {
+		if ps[i] != ds[i] {
+			return false
+		}
+	}
+	return true
+}
