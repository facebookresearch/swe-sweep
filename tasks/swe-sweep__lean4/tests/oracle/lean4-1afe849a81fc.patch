+/--
+Returns `true` if `declName` is the name of a `match` equational theorem.
+-/
+def isMatchEqnTheorem (env : Environment) (declName : Name) : Bool :=
+  matchEqnsExt.getState env |>.eqns.contains declName
+
 end Lean.Meta.Match
