+    @pytest.mark.parametrize('n_channels', range(1, 4))
+    @pytest.mark.parametrize('order', range(2, 6))
+    def test_map_coordinates_reflect_multichannel(self, n_channels, order):
+        # Regression test for gh-24550: reflect mode spline prefilter had an
+        # aliasing bug that caused accuracy loss for multi-channel images.
+        rng = numpy.random.RandomState(4567)
+        image = rng.random_sample((8, 8)).astype(numpy.float64)
+        coords = rng.random_sample((2, 5, 5)) * 7
+
+        single = ndimage.map_coordinates(image, coords, order=order,
+                                         mode='reflect')
+
+        color = numpy.stack([image] * n_channels, axis=-1)
+        channels = numpy.broadcast_to(numpy.arange(n_channels),
+                                      (1, 5, 5, n_channels))
+        coords_color = numpy.broadcast_to(
+            coords[..., numpy.newaxis], (2, 5, 5, n_channels))
+        coords_color = numpy.concatenate(
+            (coords_color, channels), axis=0)
+
+        multi = ndimage.map_coordinates(color, coords_color, order=order,
+                                        mode='reflect')
+        expected = numpy.stack([single] * n_channels, axis=-1)
+        assert_array_almost_equal(multi, expected)
+
