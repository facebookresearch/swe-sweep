+func TestIssue69183(t *testing.T) {
+	const src = `package A
+import (
+"a"//a
+"a")
+`
+	fset := token.NewFileSet()
+	f, err := parser.ParseFile(fset, "test.go", src, parser.ParseComments|parser.SkipObjectResolution)
