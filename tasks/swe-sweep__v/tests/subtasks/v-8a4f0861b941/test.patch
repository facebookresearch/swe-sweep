new file mode 100644
index 000000000..de002006d
--- /dev/null
+++ b/vlib/v/tests/sumtype_as_cast_2_test.v
@@ -0,0 +1,31 @@
+type Numbers = int | string
+
+struct Values {
+	value Numbers
+}
+
+struct Wrapper {
+	element []Values
+mut:
+	index int
+}
+
+fn (mut instance Wrapper) get() Values {
+	instance.index++
+	return instance.element[0]
+}
+
+fn test_sumtype_as_cast() {
+	mut wrapper := Wrapper{
+		element: [
+			Values{
+				value: 1
+			},
+			Values{
+				value: '2'
+			},
+		]
+	}
+	println(wrapper.get().value as int)
+	assert wrapper.index == 1
+}
