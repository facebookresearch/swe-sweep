+//
+
+fn fnormal(mut acc []string, e int) []string {
+	acc << e.str()
+	return acc
+}
+
+fn test_anon_fn_returning_a_mut_parameter_should_act_the_same_as_normal_fn_returning_a_mut_parameter() {
+	fanon := fn (mut acc []string, e int) []string {
+		acc << e.str()
+		return acc
+	}
+	assert '${fanon}' == '${fnormal}'
+	mut a := ['a', 'b', 'c']
+	mut b := a.clone()
+	x := fanon(mut a, 123)
+	y := fnormal(mut b, 123)
+	assert a == b
+}
