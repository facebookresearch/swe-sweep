diff --git a/vlib/v/tests/struct_field_named_as_c_keyword_test.v b/vlib/v/tests/struct_field_named_as_c_keyword_test.v
new file mode 100644
index 000000000..7feca9951
--- /dev/null
+++ b/vlib/v/tests/struct_field_named_as_c_keyword_test.v
@@ -0,0 +1,22 @@
+struct Foo {
+	do fn () = unsafe { nil }
+}
+
+struct Foo2 {
+	do fn () = unsafe { nil }
+}
+
+type CallAlias = Foo | Foo2
+
+fn get() CallAlias {
+	return Foo{
+		do: fn () {
+			println('cool')
+		}
+	}
+}
+
+fn test_struct_with_a_field_named_with_a_c_keyword() {
+	a := get().do
+	a()
+}
