diff --git a/vlib/v/tests/concat_option_test.v b/vlib/v/tests/concat_option_test.v
new file mode 100644
index 000000000..2c6445751
--- /dev/null
+++ b/vlib/v/tests/concat_option_test.v
@@ -0,0 +1,20 @@
+fn opt(arg ?int) ?int {
+	return arg
+}
+
+fn test_main() {
+	_, a, b, c, d := match 0 {
+		0 {
+			a := ?bool(true)
+			b := ?bool(none)
+			3, a, b, opt(none), opt(5)
+		}
+		else {
+			3, ?bool(false), ?bool(false), ?int(false), ?int(false)
+		}
+	}
+	assert a? == true
+	assert b == none
+	assert c == none
+	assert d? == 5
+}
