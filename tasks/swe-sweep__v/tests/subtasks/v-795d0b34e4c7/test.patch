diff --git a/vlib/v/tests/interface_multi_return_test.v b/vlib/v/tests/interface_multi_return_test.v
new file mode 100644
index 000000000..8cb53c298
--- /dev/null
+++ b/vlib/v/tests/interface_multi_return_test.v
@@ -0,0 +1,28 @@
+interface ITest {
+	test() bool
+}
+
+struct Test {}
+
+fn (p Test) test() bool {
+	println('p.test()')
+	return true
+}
+
+fn get_test(id int) (?ITest, string) {
+	match id {
+		0 { return Test{}, 'Value 0' }
+		else { return none, 'Value not 0' }
+	}
+}
+
+fn test_main() {
+	t, _ := get_test(0)
+
+	if tt := t {
+		assert t != none
+		assert tt.test() == true
+	} else {
+		assert false
+	}
+}
