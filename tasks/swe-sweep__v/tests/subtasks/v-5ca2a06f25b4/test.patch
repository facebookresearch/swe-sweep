diff --git a/vlib/v/tests/anon_struct_with_default_expr_test.v b/vlib/v/tests/anon_struct_with_default_expr_test.v
new file mode 100644
index 000000000..58b2a3f75
--- /dev/null
+++ b/vlib/v/tests/anon_struct_with_default_expr_test.v
@@ -0,0 +1,15 @@
+struct Bar {
+	anon struct {
+		foofoo Foo = Foo{'foofoo'}
+	}
+}
+
+struct Foo {
+	name string
+}
+
+fn test_anon_struct_with_default_expr() {
+	bar := Bar{}
+	println(bar.anon.foofoo.name)
+	assert bar.anon.foofoo.name == 'foofoo'
+}
