diff --git a/vlib/v/tests/map_value_ref_interp_test.v b/vlib/v/tests/map_value_ref_interp_test.v
new file mode 100644
index 000000000..e744ea815
--- /dev/null
+++ b/vlib/v/tests/map_value_ref_interp_test.v
@@ -0,0 +1,25 @@
+module main
+
+struct Inner {
+	value int
+}
+
+struct Outer {
+	value map[string]&Inner
+}
+
+fn test_main() {
+	outer := Outer{
+		value: {
+			'test': &Inner{
+				value: 1
+			}
+		}
+	}
+	expected := "Outer{
+    value: {'test': &Inner{
+        value: 1
+    }}
+}"
+	assert '${outer}' == expected
+}
