diff --git a/vlib/v/tests/indexexpr_with_anon_fn_test.v b/vlib/v/tests/indexexpr_with_anon_fn_test.v
new file mode 100644
index 000000000..294e3cd44
--- /dev/null
+++ b/vlib/v/tests/indexexpr_with_anon_fn_test.v
@@ -0,0 +1,21 @@
+module main
+
+pub struct Tree {}
+
+pub type TreeBelt = map[string]fn (input &Tree, belt TreeBelt) []&Tree
+
+pub fn (tree &Tree) processed() TreeBelt {
+	mut blet := TreeBelt(map[string]fn (&Tree, TreeBelt) []&Tree{})
+	blet['foo'] = fn (input &Tree, belt TreeBelt) []&Tree {
+		return [input]
+	}
+	return blet
+}
+
+fn test_main() {
+	tree := Tree{}
+	ret := tree.processed()
+	assert ret.len == 1
+	ret2 := ret['foo'](tree, ret)
+	assert ret2[0] == tree
+}
