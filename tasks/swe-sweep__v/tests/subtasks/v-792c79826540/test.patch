diff --git a/vlib/json/json_decode_option_enum_test.v b/vlib/json/json_decode_option_enum_test.v
new file mode 100644
index 000000000..f7dda4cd9
--- /dev/null
+++ b/vlib/json/json_decode_option_enum_test.v
@@ -0,0 +1,18 @@
+import json
+
+enum Lang {
+	en = 1
+}
+
+struct Request {
+	lang ?Lang // ?string, ?int are ok
+}
+
+fn test_main() {
+	assert dump(json.decode(Request, '{}')!) == Request{
+		lang: ?Lang(none)
+	}
+	assert dump(json.decode(Request, '{"lang": "en"}')!) == Request{
+		lang: .en
+	}
+}
