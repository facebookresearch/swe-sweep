diff --git a/vlib/v/tests/generic_comptime_test.v b/vlib/v/tests/generic_comptime_test.v
new file mode 100644
index 000000000..4b766ef9f
--- /dev/null
+++ b/vlib/v/tests/generic_comptime_test.v
@@ -0,0 +1,26 @@
+struct EmptyStruct {
+	b []int = [1, 2, 3]
+}
+
+fn encode_array[T](val []T) []int {
+	return val
+}
+
+fn encode_struct[T](val T) []int {
+	$if T is $struct {
+		$for field in T.fields {
+			$if field.is_array {
+				return encode_array(val.$(field.name))
+			}
+		}
+	}
+	return [0]
+}
+
+fn encoder() []int {
+	return encode_struct(EmptyStruct{})
+}
+
+fn test_main() {
+	assert encoder() == [1, 2, 3]
+}
