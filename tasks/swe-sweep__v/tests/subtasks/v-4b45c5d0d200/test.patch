diff --git a/vlib/v/tests/option_auto_heap_test.v b/vlib/v/tests/option_auto_heap_test.v
new file mode 100644
index 000000000..f918f66a7
--- /dev/null
+++ b/vlib/v/tests/option_auto_heap_test.v
@@ -0,0 +1,24 @@
+struct Teste {
+pub mut:
+	teste ?&Teste
+}
+
+fn test_main() {
+	mut a := Teste{}
+	a.teste = &a
+	dump(a) // circular
+
+	assert a.teste? == &a
+
+	mut t := ?Teste{}
+	w := dump(t) // Option(none)
+	assert w == none
+
+	mut z := ?Teste{}
+	z = Teste{}
+	z?.teste = &z
+	dump(z) // // circular
+
+	y := z?
+	assert y.teste? == &z?
+}
