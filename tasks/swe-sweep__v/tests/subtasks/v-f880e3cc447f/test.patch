diff --git a/vlib/v/tests/closure_in_if_guard_test.v b/vlib/v/tests/closure_in_if_guard_test.v
new file mode 100644
index 000000000..f5dea1d5a
--- /dev/null
+++ b/vlib/v/tests/closure_in_if_guard_test.v
@@ -0,0 +1,16 @@
+struct Foo {
+	optional ?int
+}
+
+fn test_closure_in_if_guard() {
+	f := Foo{45}
+	mut ret := ''
+	if v := f.optional {
+		func := fn [v] () string {
+			println(v)
+			return '${v}'
+		}
+		ret = func()
+	}
+	assert ret == '45'
+}
