diff --git a/vlib/v/tests/thread_ptr_ret_test.v b/vlib/v/tests/thread_ptr_ret_test.v
new file mode 100644
index 000000000..6d5f177c6
--- /dev/null
+++ b/vlib/v/tests/thread_ptr_ret_test.v
@@ -0,0 +1,21 @@
+fn test_main() {
+	foo := spawn get_pointer()
+	ret := foo.wait()
+	assert *ret == 42
+}
+
+fn test_opt() {
+	foo := spawn get_pointer_opt()
+	ret := foo.wait()
+	assert *ret? == 42
+}
+
+fn get_pointer() &int {
+	val := 42
+	return &val
+}
+
+fn get_pointer_opt() ?&int {
+	val := 42
+	return &val
+}
