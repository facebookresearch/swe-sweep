diff --git a/vlib/v/tests/aliases/alias_updated_expr_test.v b/vlib/v/tests/aliases/alias_updated_expr_test.v
new file mode 100644
index 000000000..cf6aaacce
--- /dev/null
+++ b/vlib/v/tests/aliases/alias_updated_expr_test.v
@@ -0,0 +1,21 @@
+module main
+
+struct Cfg {
+	item string
+}
+
+type AliasCfg = Cfg
+
+fn foo(cfg &AliasCfg) {
+	var := &AliasCfg{
+		...cfg
+		item: 'foo'
+	}
+	assert var.item == 'foo'
+}
+
+fn test_main() {
+	foo(AliasCfg{
+		item: 'bar'
+	})
+}
