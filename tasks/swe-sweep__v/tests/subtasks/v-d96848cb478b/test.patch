diff --git a/vlib/v/tests/comptime_is_check_test.v b/vlib/v/tests/comptime_is_check_test.v
new file mode 100644
index 000000000..6b8c820ed
--- /dev/null
+++ b/vlib/v/tests/comptime_is_check_test.v
@@ -0,0 +1,15 @@
+fn test[T](val T) string {
+	$if T is u32 {
+		$compile_error('u32')
+		return ''
+	} $else $if T !is string {
+		$compile_error('not string')
+		return ''
+	} $else {
+		return val
+	}
+}
+
+fn test_main() {
+	assert test('str') == 'str'
+}
