diff --git a/vlib/v/tests/generic_struct_init_with_reference_struct_type_test.v b/vlib/v/tests/generic_struct_init_with_reference_struct_type_test.v
new file mode 100644
index 000000000..ab906fdcb
--- /dev/null
+++ b/vlib/v/tests/generic_struct_init_with_reference_struct_type_test.v
@@ -0,0 +1,22 @@
+import datatypes { Stack }
+
+struct Person {
+mut:
+	name string
+	age  int
+}
+
+fn test_generic_struct_init_with_reference_struct_type() {
+	mut adam := &Person{'Adam', 21}
+	println(adam)
+
+	mut people := Stack[&Person]{}
+	people.push(adam)
+	assert people.len() == 1
+
+	mut top_person := people.pop()!
+	top_person.age++
+	println(adam)
+
+	assert people.len() == 0
+}
