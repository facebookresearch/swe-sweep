diff --git a/vlib/v/tests/generic_fn_infer_map_argument_test.v b/vlib/v/tests/generic_fn_infer_map_argument_test.v
new file mode 100644
index 000000000..233b1c772
--- /dev/null
+++ b/vlib/v/tests/generic_fn_infer_map_argument_test.v
@@ -0,0 +1,17 @@
+fn f[T](src map[string]T) T {
+	return src['a']
+}
+
+fn test_generic_fn_infer_map_arg() {
+	r1 := f({
+		'a': 1
+	})
+	println(r1)
+	assert r1 == 1
+
+	r2 := f({
+		'a': 'hello'
+	})
+	println(r2)
+	assert r2 == 'hello'
+}
