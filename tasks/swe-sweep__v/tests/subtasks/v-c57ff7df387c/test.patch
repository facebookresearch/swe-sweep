diff --git a/vlib/v/tests/method_call_none_check_test.v b/vlib/v/tests/method_call_none_check_test.v
new file mode 100644
index 000000000..9600c31ee
--- /dev/null
+++ b/vlib/v/tests/method_call_none_check_test.v
@@ -0,0 +1,28 @@
+struct Foo {
+	x int
+}
+
+struct Bar {
+	x int
+}
+
+type Foobar = Bar | Foo
+
+struct Foobars {
+	m map[string]Foobar
+}
+
+fn (f &Foobars) find_foobar(name string) ?Foobar {
+	return f.m[name] or { return none }
+}
+
+fn (mut f Foobars) is_known(name string) bool {
+	return f.find_foobar(name) != none
+}
+
+fn test_main() {
+	mut foobars := Foobars{
+		m: map[string]Foobar{}
+	}
+	assert foobars.is_known('deadbeef') == false
+}
