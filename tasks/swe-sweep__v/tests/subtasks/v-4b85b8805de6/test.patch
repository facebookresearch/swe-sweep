diff --git a/vlib/v/tests/generic_struct_recursive_test.v b/vlib/v/tests/generic_struct_recursive_test.v
new file mode 100644
index 000000000..e58d2e3fe
--- /dev/null
+++ b/vlib/v/tests/generic_struct_recursive_test.v
@@ -0,0 +1,20 @@
+struct Node[T] {
+mut:
+	value T
+	next  ?&Node[T] = none
+}
+
+fn test_main() {
+	mut n := Node[int]{
+		value: 1
+	}
+	mut m := Node[int]{
+		value: 2
+	}
+	n.next = &m
+	a := n.next or { return }
+	dump(a)
+	dump(m)
+	dump(n)
+	assert a.value == 2
+}
