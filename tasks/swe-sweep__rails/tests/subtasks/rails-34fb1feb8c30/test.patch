+      travel_to(date1) do
+        travel_object.travel_to_no_block(date2)
+        assert_equal date2, Date.today
+      end
+      assert_equal now, Time.now
+
+      travel_to(date1) do
+        travel_object.travel_to_block(date2)
+        assert_equal date1, Date.today
+      end
+      assert_equal now, Time.now
+    end
