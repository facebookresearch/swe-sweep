+
+    fireEvent.mouseMove(container.firstChild, {
+      clientX: 21,
+    });
+    // one full star highlighted
+    expect(container.querySelectorAll(`.${classes.iconHover}`).length).to.equal(2);
+
+    fireEvent.mouseMove(container.firstChild, {
+      clientX: 39,
+    });
