+// Convert a CONVFMT or OFMT value to its equivalent Go format string.
+func (p *interp) goFloatFormat(format string) string {
+	goFormat, types, err := p.parseFmtTypes(format)
+	if err != nil || len(types) != 1 || types[0] != 'f' {
+		return format
+	}
+	return goFormat
+}
