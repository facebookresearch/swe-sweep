+function logpdf(d::Chi, x::Real)
+    ν, _x = promote(d.ν, x)
+    xsq = _x^2
+    val = (xlogy(ν - 1, xsq / 2) - xsq + logtwo) / 2 - loggamma(ν / 2)
+    return x < zero(x) ? oftype(val, -Inf) : val
+end
 
 gradlogpdf(d::Chi{T}, x::Real) where {T<:Real} = x >= 0 ? (d.ν - 1) / x - x : zero(T)
 
