+# computes 2nd moment of standard normal distribution truncated to [a, b]
+function _tnmom2(a::Real, b::Real)
+    if !(a ≤ b)
+        return oftype(middle(a, b), NaN)
+    elseif a == b
+        return middle(a, b)^2
+    elseif abs(a) > abs(b)
+        return _tnmom2(-b, -a)
+    elseif isinf(a) && isinf(b)
+        return one(middle(a, b))
+    elseif isinf(b)
+        return 1 + √(2 / π) * a / erfcx(a / √2)
+    end
+
+    if a ≤ 0 ≤ b
+        ea = √(π/2) * erf(a / √2)
+        eb = √(π/2) * erf(b / √2)
+        fa = ea - a * exp(-a^2 / 2)
+        fb = eb - b * exp(-b^2 / 2)
+        m2 = (fb - fa) / (eb - ea)
+        return m2
+    else # 0 ≤ a ≤ b
+        exΔ = exp((a - b)middle(a, b))
+        ea = √(π/2) * erfcx(a / √2)
+        eb = √(π/2) * erfcx(b / √2)
+        fa = ea + a
+        fb = eb + b
+        m2 = (fa - fb * exΔ) / (ea - eb * exΔ)
+        return m2
+    end
 end
 
