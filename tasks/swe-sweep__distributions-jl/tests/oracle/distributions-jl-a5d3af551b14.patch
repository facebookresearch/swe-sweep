+function _tnvar(a::Real, b::Real)
+    if a == b
+        return zero(middle(a, b))
+    elseif a < b
+        m1 = _tnmom1(a, b)
+        m2 = √_tnmom2(a, b)
+        return (m2 - m1) * (m2 + m1)
+    else
+        return oftype(middle(a, b), NaN)
+    end
 end
 
