+lambdaLiftExpr :: [Arg Name] -> Expr -> Expr
+lambdaLiftExpr ns e = foldr f e ns
+  where
+  f arg = Lam exprNoRange $ setHiding (getHiding arg) $ mkDomainFree $ defaultNamedArg $ mkBinder_ $ unArg arg
 
