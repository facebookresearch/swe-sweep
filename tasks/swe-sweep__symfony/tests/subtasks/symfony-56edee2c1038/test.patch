+                }
+
+                return true;
+            }
+        };
+
+        $factory = new LazyLoadingMetadataFactory($loader);
+        $metadata = $factory->getMetadataFor(self::CLASS_NAME);
+
+        $firstNameMetadata = $metadata->getPropertyMetadata('firstName');
