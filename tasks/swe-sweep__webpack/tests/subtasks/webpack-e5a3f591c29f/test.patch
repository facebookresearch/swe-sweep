diff --git a/test/hotCases/lazy-compilation/unrelated/index.js b/test/hotCases/lazy-compilation/unrelated/index.js
new file mode 100644
index 000000000..948104725
--- /dev/null
+++ b/test/hotCases/lazy-compilation/unrelated/index.js
@@ -0,0 +1,25 @@
+import value from "./module";
+
+const neverCalled = () => import("./lazy");
+
+it("should compile to lazy imported module", done => {
+	let generation = 0;
+	module.hot.accept("./module", () => {
+		generation++;
+	});
+	expect(value).toBe(42);
+	expect(generation).toBe(0);
+	NEXT(
+		require("../../update")(done, true, () => {
+			expect(value).toBe(43);
+			expect(generation).toBe(1);
+			NEXT(
+				require("../../update")(done, true, () => {
+					expect(value).toBe(44);
+					expect(generation).toBe(2);
+					done();
+				})
+			);
+		})
+	);
+});
