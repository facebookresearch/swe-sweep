--- /dev/null
+++ b/test/configCases/web/node-source-global/test.config.js
@@ -0,0 +1,8 @@
+module.exports = {
+	moduleScope(scope) {
+		scope.global = scope.global || {};
+		scope.global.value1 = "error";
+		scope.globalThis = scope.globalThis || {};
+		scope.globalThis.value1 = "value1";
+	}
+};
