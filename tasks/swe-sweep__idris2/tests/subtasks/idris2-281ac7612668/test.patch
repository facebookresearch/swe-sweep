diff --git a/tests/idris2/reflection021/QuoteSearch.idr b/tests/idris2/reflection021/QuoteSearch.idr
new file mode 100644
index 000000000..241b42f1f
--- /dev/null
+++ b/tests/idris2/reflection021/QuoteSearch.idr
@@ -0,0 +1,22 @@
+module QuoteSearch
+
+import Language.Reflection
+
+%language ElabReflection
+
+x : Elab Nat
+x = check `(%search)
+
+defy : Elab ()
+defy = do
+    let fc = EmptyFC
+
+    val <- quote !x
+    logTerm "" 0 "Quoted term:" val
+
+    declare [
+        IClaim fc MW Private [] (MkTy fc fc (UN (Basic "y")) (IVar fc (UN (Basic "Nat")))),
+        IDef fc (UN (Basic "y")) [PatClause fc (IVar fc (UN (Basic "y"))) (IApp fc (IApp fc (IVar fc (UN (Basic "+"))) val) val)]
+    ]
+
+%runElab defy
