diff --git a/tests/idris2/rewrite001/Issue2573.idr b/tests/idris2/rewrite001/Issue2573.idr
new file mode 100644
index 000000000..c53f25f8c
--- /dev/null
+++ b/tests/idris2/rewrite001/Issue2573.idr
@@ -0,0 +1,13 @@
+module Issue2573
+
+||| Define foo, the identity function in disguise
+foo : Ord a => (x : a) -> a
+foo x = if x < x then x else x
+
+||| Assume that foo x = x
+eq : Ord a => (a -> a) -> (x : a) -> Issue2573.foo x = x
+eq f x = believe_me ()
+
+||| Prove that if x < y then (foo x) < y
+prf : Ord a => (a -> a) -> (x, y : a) -> x < y = True -> Issue2573.foo x < y = True
+prf f x y lt = rewrite (eq f x) in lt
