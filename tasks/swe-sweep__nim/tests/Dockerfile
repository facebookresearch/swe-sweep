# Maximally-buggy Nim — frozen at v1.6.0.
#
# Built upstream by `pandora construct build-image -t nim@1.6.0`, which prepares the build context
# from the local clone (no GitHub access — see docs/ai/010-design/005-style-conventions.md):
# it exports the Nim source tree at that tag into ./nim and copies this file in as
# ./Dockerfile. The image holds the Nim git tree with a `baseline` commit+tag; the
# host-controlled evaluator (tasks/nim/task.yaml) does `git reset --hard
# baseline`, then applies the per-bug test/gold patches and rebuilds.
#
# Four things are specific to Nim:
#
# 1. **The compiler bootstraps from generated C.** `build_all.sh` clones the matching
#    `csources_v*` repo — the compiler translated to C by a compiler of that era — builds
#    it with `make`, and uses the result to compile the real compiler. The hash it clones
#    is pinned by the tree's own `config/build_config.txt`, so the bootstrap is
#    period-correct without anything being pinned here. The clone lands in a directory Nim
#    gitignores, which is what lets the `git clean` between subtasks leave it alone.
#
# 2. **The per-subtask rebuild is one stage, not a bootstrap.** `./koch boot` compiles the
#    compiler with itself two or three times over to prove the result is self-reproducing;
#    that is a release-engineering check, not something a bug fix needs, and it costs tens
#    of minutes per subtask. `nim-build` compiles the patched compiler *once* with the
#    already-built one, which is what `koch temp` does for exactly this reason.
#
# 3. **A running binary cannot be its own output.** `bin/nim` is the compiler doing the
#    compiling, so writing the new one straight over it fails with "Text file busy". Both
#    binaries are built to /tmp and copied into place.
#
# 4. **Debian bullseye, not a current base.** csources is C generated by a 2019-era
#    compiler and leans on implicit function declarations, which GCC 14 rejects outright.
#    Bullseye's GCC 10 still accepts them.
# --- SWE-sweep Harbor port: source trees come from clone stages ---
FROM docker.io/library/alpine:3.20 AS swesweep-src
RUN apk add --no-cache git
RUN set -eu \
 && git clone --quiet --no-checkout https://github.com/nim-lang/Nim.git /src \
 && git -C /src checkout --quiet v1.6.0 \
 && git -C /src submodule update --init --recursive --quiet \
 && echo "swesweep-src: $(git -C /src rev-parse HEAD)" \
 && find /src -name .git -prune -exec rm -rf {} +

FROM docker.io/library/alpine:3.20 AS swesweep-python
RUN apk add --no-cache curl \
 && curl -fsSL -o /pbs.tgz "https://github.com/astral-sh/python-build-standalone/releases/download/20260924/cpython-3.12.14%2B20260924-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz" \
 && echo "269b2c99e4db15b242bf01832f4fea1e8f1a664f273cff519393f296e9820b41  /pbs.tgz" | sha256sum -c - \
 && mkdir -p /opt/swesweep && tar -xzf /pbs.tgz -C /opt/swesweep && rm /pbs.tgz

# --- upstream Dockerfile, unchanged below ---
FROM debian:bullseye
# --- SWE-sweep Harbor port: apt repositories of EOL Debian suites ---
RUN if [ -r /etc/os-release ]; then . /etc/os-release; case "${VERSION_CODENAME:-}" in \
      stretch|buster) [ -f /etc/apt/sources.list ] && sed -i -e 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g' -e 's|http://security.debian.org/debian-security|http://archive.debian.org/debian-security|g' -e 's|http://security.debian.org|http://archive.debian.org/debian-security|g' -e '/-updates/d' /etc/apt/sources.list; printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99swesweep-eol ;; \
      bullseye) if [ -f /etc/apt/sources.list ] && grep -q '^# deb http://snapshot.debian.org' /etc/apt/sources.list; then sed -i -e '\|^# deb http://snapshot.debian.org.* bullseye main$|!s|^# deb http://snapshot.debian.org|deb http://snapshot.debian.org|' -e '\|^deb http://deb.debian.org/debian bullseye main$|!{\|^deb http://deb.debian.org|d}' /etc/apt/sources.list; elif [ -f /etc/apt/sources.list ]; then sed -i -e '/bullseye-security/d' -e '/bullseye-updates/d' /etc/apt/sources.list; fi; printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "5";\n' > /etc/apt/apt.conf.d/99swesweep-eol ;; \
    esac; fi

ENV DEBIAN_FRONTEND=noninteractive
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git make \
        libpcre3-dev libssl-dev libgc-dev sqlite3 libsqlite3-dev \
        nodejs xz-utils; \
    rm -rf /var/lib/apt/lists/*

# Nim source tree at the anchor tag, exported from the local clone into the build context
# (see the header).
COPY --from=swesweep-src /src /nim
WORKDIR /nim

# Make the exported tree a git repo (the export carries no .git), commit the source and tag
# it `baseline`. Two details: the branch is `main`, not `baseline`, because a branch and a
# tag of the same name make every `git reset --hard baseline` warn about an ambiguous
# refname; and it has to *be* a branch, because several of Nim's own tools shell out to
# `git symbolic-ref --short HEAD` and quit when it fails.
RUN git init -q -b main \
    && git config user.email v@x && git config user.name v \
    && git add -A && git commit -q -m "nim maxbug source" && git tag baseline

# Bootstrap: csources -> koch -> the real compiler -> the bundled tools. Invoked through
# `sh` because the executable bit is not set on this script in every era of the tree, and
# the build context is transferred as bytes.
RUN sh ./build_all.sh

ENV PATH=/nim/bin:$PATH

# Testament is the corpus driver. `koch tests` builds it, but it also insists on running
# something, so it is compiled directly.
RUN bin/nim c -d:release --skipUserCfg --skipParentCfg --hints:off testament/testament.nim

# One script for both the image build and the per-subtask rebuild, so the flags cannot
# drift apart.
RUN set -eux; \
    printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      'cd /nim' \
      'JOBS="${SWESWEEP_BUILD_JOBS:-4}"' \
      'FLAGS="-d:release --skipUserCfg --skipParentCfg --hints:off"' \
      '# shellcheck disable=SC2086' \
      'bin/nim c $FLAGS --parallelBuild:"$JOBS" -o:/tmp/nim.new compiler/nim.nim' \
      'cp -f /tmp/nim.new bin/nim' \
      '# shellcheck disable=SC2086' \
      'bin/nim c $FLAGS --parallelBuild:"$JOBS" -o:/tmp/testament.new testament/testament.nim' \
      'cp -f /tmp/testament.new testament/testament' \
      > /usr/local/bin/nim-build; \
    chmod +x /usr/local/bin/nim-build

RUN nim-build

CMD ["nim", "--version"]

# --- SWE-sweep Harbor port: the sandbox idles; the harness execs into it ---
ENTRYPOINT []
CMD ["sleep", "infinity"]
# --- SWE-sweep verifier: the evaluator's interpreter and the test fixture ---
COPY --from=swesweep-python /opt/swesweep/python /opt/swesweep/python
COPY . /tests
RUN chmod +x /tests/test.sh
