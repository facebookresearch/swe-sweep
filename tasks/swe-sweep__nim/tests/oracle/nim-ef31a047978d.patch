         if semCheck:
-          it[1] = semExpr(c, it[1])
+          it[1] = semNimvmBranch(c, it[1])
           typ = commonType(c, typ, it[1].typ)
         result = n # when nimvm is not elimited until codegen
       else:
@@ -2441,7 +2457,8 @@
       checkSonsLen(it, 1, c.config)
       if result == nil or whenNimvm:
         if semCheck:
-          it[0] = semExpr(c, it[0])
