diff --git a/tests/whenstmt/twhen_nimvm_push.nim b/tests/whenstmt/twhen_nimvm_push.nim
new file mode 100644
index 000000000..7991239fc
--- /dev/null
+++ b/tests/whenstmt/twhen_nimvm_push.nim
@@ -0,0 +1,21 @@
+discard """
+  output: "ok"
+"""
+
+var overflowDetected = false
+when nimvm:
+  {.push overflowChecks: off.}
+else:
+  var branchX = high(int)
+  try:
+    inc branchX
+  except OverflowDefect:
+    overflowDetected = true
+
+doAssert overflowDetected
+
+var x = high(int)
+try:
+  inc x
+except OverflowDefect:
+  echo "ok"
