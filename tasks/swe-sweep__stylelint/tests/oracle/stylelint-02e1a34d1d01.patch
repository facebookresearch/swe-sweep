+	const node = tag.parent?.parent;
+
+	return selectorParser.isPseudoClass(node) && IGNORED_PSEUDO_CLASSES.has(node.value);
+}
+
 rule.ruleName = ruleName;
 rule.messages = messages;
 rule.meta = meta;
