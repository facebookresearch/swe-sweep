+            raise ValueError
+
+        print(e1.foo)
+        print(e1.exception)
+
+        print(e2.foo)
+        print(e2.exception)
+
+    def test_rewrite_references_multiple_items_nested(self):
+        with self.assertRaises(ValueError) as e1, \
+            foo(self.assertRaises(ValueError)) as e2:
+            raise ValueError
+
+        print(e1.foo)
+        print(e1.exception)
+
+        print(e2.foo)
+        print(e2.exception)
