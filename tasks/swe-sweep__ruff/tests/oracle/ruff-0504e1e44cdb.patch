-            Ok(Fix::safe_edits(binding_edit, import_edit))
+            Ok(Fix::applicable_edits(
+                binding_edit,
+                import_edit,
+                if checker.comment_ranges().intersects(expr.range()) {
+                    Applicability::Unsafe
+                } else {
+                    Applicability::Safe
+                },
+            ))
         });
     }
