+test('maxCapacity defaults to minCapacity when using Token', () => {
+  // GIVEN
+  const stack = new cdk.Stack(undefined, 'MyStack', { env: { region: 'us-east-1', account: '1234' } });
+  const vpc = mockVpc(stack);
+
+  const minCapacity = new cdk.CfnParameter(stack, 'Min', { type: 'Number' });
+
+  // WHEN
+  new autoscaling.AutoScalingGroup(stack, 'MyFleet', {
+    instanceType: ec2.InstanceType.of(ec2.InstanceClass.M4, ec2.InstanceSize.MICRO),
+    machineImage: new ec2.AmazonLinuxImage(),
+    vpc,
+    minCapacity: minCapacity.valueAsNumber,
+  });
+
+  // THEN
+  expect(stack).to(haveResourceLike('AWS::AutoScaling::AutoScalingGroup', {
+    MinSize: { Ref: 'Min' },
+    MaxSize: { Ref: 'Min' },
+  }));
+});
