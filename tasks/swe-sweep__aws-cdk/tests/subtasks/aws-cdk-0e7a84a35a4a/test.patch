+  });
+
+  // THEN
+  expect(stack).to(haveResourceLike('AWS::AutoScaling::ScalingPolicy', {
+    PolicyType: 'StepScaling',
+    AdjustmentType: 'ChangeInCapacity',
+  }));
+});
